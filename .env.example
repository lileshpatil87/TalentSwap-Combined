# .env.example (repository root)
#
# Shared variables consumed by infrastructure/docker/docker-compose.yml.
# Per DEV-CON-v1.0 §6.1: copy this file to `.env` and fill in real local
# values. `.env` is gitignored — never commit it. `.env` here does NOT
# replace apps/api/.env or apps/web/.env.local, which hold app-specific
# variables (see apps/api/.env.example and apps/web/.env.example).

# --- PostgreSQL 16 (local Docker Compose only) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=talentswap_dev
POSTGRES_PORT=5432
# Optional per-region Aurora reader endpoint; blank means use the primary for reads.
DATABASE_READ_URL=

# --- Redis 7 (local Docker Compose only) ---
REDIS_PORT=6379

# --- Mailhog (local outbound email capture — DEV-CON-v1.0 §8.4) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# --- Service host ports (see DEV-CON-v1.0 §13.2 port allocation table) ---
API_PORT=4000
WEB_PORT=3000

# --- Self-hosted fallback ONLY (infrastructure/docker/docker-compose.prod.yml
#     + infrastructure/nginx/nginx.conf, DEV-CON-v1.0 §10.1/§12). Not read by
#     the default local-dev docker-compose.yml above, and not used by the
#     MVP Vercel/Railway deployment path. See docker-compose.prod.yml's own
#     header comment before using this file. ---
NGINX_HTTP_PORT=80
# POSTGRES_PASSWORD has no default in docker-compose.prod.yml (unlike the
# local-dev default above) — it must be set explicitly for that file.

# Password-reset email delivery (required for /auth/forgot-password)
RESEND_API_KEY=
EMAIL_FROM=TalentSwap <noreply@example.com>
APP_PUBLIC_URL=http://localhost:3000

# Worker private object storage access for malware scanning
R2_ENDPOINT=
R2_BUCKET=talentswap
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Phase 4 scaling (disabled by default; PostgreSQL remains the default search backend)
SEARCH_BACKEND=postgres
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=
SFU_SHARED_SECRET=
SFU_PUBLIC_URL=
SFU_TOKEN_TTL_SECONDS=300
SFU_ANNOUNCED_IP=127.0.0.1
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
