# apps/web environment variables
#
# Copy this file to .env.local and fill in real values for local
# development. .env.local is gitignored and never committed (Arch §8.1).
#
# Only NEXT_PUBLIC_* variables are readable by client-side code — never
# put a secret behind a NEXT_PUBLIC_ prefix (Arch §13 rule 1).
#
# CANONICAL NAMES — DO NOT RENAME: these two variable names and the
# schema in lib/env.ts are the enforced contract (Zod, fail-fast at boot,
# Arch §8.2). Any other file that sets these for local/CI/staging/prod
# (infrastructure/docker/docker-compose.yml, apps/api's own .env.example,
# scripts/setup.sh, Vercel project settings) must use these exact names —
# this file does not get renamed to match ops tooling; the reverse is
# what the AI SDLC's "flag, don't silently diverge" discipline calls for.
#
# Reconciled 2026-08-08 (integration review): this file and DevOps's copy
# of it had independently drifted on both variable names AND port number
# (3001 here vs. 4000 in docker-compose.yml). Names now match lib/env.ts
# exactly; port now matches apps/api's actual default (PORT=4000 in
# apps/api/.env.example / docker-compose.yml's API_PORT default).

# Base URL of the NestJS REST API, versioned per Arch §9.7.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Socket.io gateway URL (default namespace) — Arch §2.5.1.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# development | staging | production — never read directly; always via
# lib/env.ts (Arch §8.2).
NEXT_PUBLIC_APP_ENV=development

# Keep true for a runnable frontend-only demo when the backend is unavailable.
# Set false in staging/production to surface backend outages instead of demo data.
NEXT_PUBLIC_DEMO_FALLBACK=true
