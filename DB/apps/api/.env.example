# TalentSwap API — Environment Variables
#
# Per Architecture Foundation §8.1: this file documents every variable a
# module needs, with a placeholder value and an explanatory comment. It is
# the contract new contributors and future sessions read to know what a
# module needs. Copy to `.env` for local development (never commit `.env`).
#
# Foundation (BE-01) defined the variables the bootstrap, database, cache,
# and config layers need. Variables owned by a specific domain module
# (JWT_* below, AGORA_*, OPENAI_*, RESEND_*, STRIPE_*, R2_*, ...) are added
# to this file by that module's own PR when it is built — do not pre-add
# them here speculatively (Architecture Foundation §8.1).

# --- Application ---
NODE_ENV=development
# development | test | staging | production
PORT=4000
API_PREFIX=api/v1
SWAGGER_ENABLED=true

# --- CORS ---
# Comma-separated allowlist of origins. Never use a wildcard in production
# (Architecture Foundation §13 rule 3 / Technology Specification §2.6).
CORS_ORIGIN=http://localhost:3000

# --- Logging ---
LOG_LEVEL=debug
# error | warn | info | debug

# --- Database (Robert / DB-01+ populate the schema; Foundation only needs the connection) ---
# Reconciled 2026-08 against DevOps's docker-compose.yml service names
# (`postgres`, `redis`) and db name (`talentswap_dev`) — this was
# previously drifted (localhost / `talentswap`), flagged in the 2026-08
# integration review. If you run this API directly on your host machine
# (not inside the Compose network — e.g. `npm run start:dev` outside
# Docker), override with `localhost` in your own `.env` instead of
# editing this file.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/talentswap_dev?schema=public

# --- Redis (cache, BullMQ, Socket.io adapter — Architecture Foundation §4.4) ---
REDIS_URL=redis://redis:6379

# --- Rate limiting tiers (Backend Constitution §40) ---
# Values below are the STANDARD tier default; AUTH/UPLOAD/ADMIN tiers are
# defined as constants in src/common/constants/app.constants.ts and do not
# need their own env vars unless a deployment needs to override them.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=200

# --- Auth: JWT access tokens (owned by the `auth` module, BE-02) ---
# RS256 asymmetric signing per Technology Specification §2.2.4/§8.2 and
# Backend Constitution §30. PEM content on a single line with literal
# `\n` sequences standing in for real newlines — this is the only format
# that survives `.env` files / Docker Compose `env_file:` unchanged.
# `normalizePem()` (src/config/configuration.ts) un-escapes it at boot.
#
# The keypair below is a throwaway, PUBLICLY KNOWN, dev-only pair
# committed to this repo so `./scripts/setup.sh` boots and authenticates
# out of the box on a fresh clone (Architecture Foundation's "one-command
# local environment bootstrap", §2.6). It is safe for local development
# ONLY, precisely because it is public.
#
#   NEVER use this keypair — or any keypair ever committed to version
#   control — in staging or production. Generate a fresh one for those
#   environments and inject it via the platform's secret store (Section
#   8.3 / Backend Constitution §48), never as a file in the repo:
#
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#     openssl rsa -pubout -in private.pem -out public.pem
#     awk 'NF {sub(/\r/, ""); printf "%s\\n", $0}' private.pem   # → JWT_PRIVATE_KEY
#     awk 'NF {sub(/\r/, ""); printf "%s\\n", $0}' public.pem    # → JWT_PUBLIC_KEY
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQCWWcq9xAyuZIWT\nnUvJxvFEmSvg3b+7ZBL/JKg+W5726egnrbdb2gNmJpUXqubPhrmnMtpNFbd2+N0a\nZgwgVizAP2pEiGgrsI5MKCrwoMHe8B+DaU0TmyiUtntDXkK4MRB2Y4wtYU/HBdkf\niL/J+CvNtkyK0sEZZK3Qh6hoUWmivwZelShG0dOQWPQigL4wQv6cjxjSmKeWVF/M\nKus0M9bx9nD2dOs67B7dJEm/nbRLAGXZ6QjYz4vX1VjahVhPcmzKF9C2ksGKKy/M\nNBP2K4WFu4idla2Dnvpcn6Rdg0i9TIUleMdNgKdtzrUlJTAwAUs5JWTCHY865l8j\nOEGD0AK1AgMBAAECggEANSdqi1tfxlnIda8DB8N7Ma7bOeT7r2LKaoSJrH4UvaNl\nTX3XWLRDRl52kEb90bmGMivCzMTUN031UStptxbwPElPJwp4lZWWQStkPuz+jXQk\nF//m3XsZxjWbb25INTk3YjuAZ9zC6RBSuhjNATjpN5FvDxdCaFlVL+d97N93cq7+\nX7kGcgFeALYalg3debdycpe8qyt9YuIROLq5FBVT7eASrFnKEwgxNtEk7JQqVWAf\ngf4R9R+lQXsVusrrOseJR8ZdtXw1I15LOs0HvGMsrCNU2zar4fErMTm0+Sl3k0Z0\ntnbZ2TsGDR2N1NwrNqHp/fy8DcN/qmgU/UztUww/swKBgQDLhP8Xwc99i50tLrfU\nnvmvojgzypkkbcuNZEPUqbsG2Aihy6zCeYbfz4D8UqQ6disFUsvEdlFl5vH5puBk\niJRNQkyB/SW70+FuSdAouNXSop0c1aU50C8HSiHFdAb5XejH7V/X7fnLKTnpZjec\nBWOpsqssV362UvpHqxRyHGWbgwKBgQC9HvKMY8DxPsGV7RQfZbtmFLeGwbEGbAW2\nlMjMoAvQdUg5BeJVyw4OTKbm2YkaWdYfyOveGK3BEruoz8PjpKEe9T54tOhiFLge\nKk9tmMFX1C+hQfmqb7vjSjaDmVY0dcezHDQXDgUJd8UnBzSDOZoxfraGgWAW9rg6\nkVlf16f7ZwKBgC6WYTZ0/SRGA1LGcPpQ8eMMhUUFyYyXPZM+MnDJ8bAdX8x5rTBP\nVVqCS4p2+HURe8OaMl7knrlu5lE5rAAXa6tL0+uloS+fzujKKMZJmVjANKrXFR1o\n1HscsyJZ7wbCQnkRk3EAXr/szf7pkS075pZ/+cMKvEzMLdKeDO4aJgA1AoGBAKLD\nRrYCiCRYAV2Z+46GDIFvZP/qJQPE5inb5PEO8PwIZA8HfGKf7knqOF5HbBKsrHcQ\ngcbUcH3RNIa1wP5jSnONV6Wk9Las5ES530AQjp2bNR7Q3CGOJiMYVNBvoFxn3WXN\n6RrKaxVZ6eiL7+rcIVNlnYsnP16kGav2OfgdbyoTAoGADMzq+4FRMYU6itixKpUa\noGIos2VK07N1NBM9f2eyRY8sMVjVVmo3SmGILq2nDexsxtUUCavLrLzOGLz2lnj5\nj4R+3ibctoXBbI7xj5eZCi58a6N8lIQlkysw6xjLBbS9URC8xWfdmePr0GJZ95SP\nj0dXoR6vavUwQDzXnzrV9Oc=\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAllnKvcQMrmSFk51Lycbx\nRJkr4N2/u2QS/ySoPlue9unoJ623W9oDZiaVF6rmz4a5pzLaTRW3dvjdGmYMIFYs\nwD9qRIhoK7COTCgq8KDB3vAfg2lNE5solLZ7Q15CuDEQdmOMLWFPxwXZH4i/yfgr\nzbZMitLBGWSt0IeoaFFpor8GXpUoRtHTkFj0IoC+MEL+nI8Y0pinllRfzCrrNDPW\n8fZw9nTrOuwe3SRJv520SwBl2ekI2M+L19VY2oVYT3JsyhfQtpLBiisvzDQT9iuF\nhbuInZWtg576XJ+kXYNIvUyFJXjHTYCnbc61JSUwMAFLOSVkwh2POuZfIzhBg9AC\ntQIDAQAB\n-----END PUBLIC KEY-----"
JWT_ISSUER=talentswap-api
# 15 minutes, per Technology Specification §2.2.4.
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# --- Auth: refresh tokens (owned by the `auth` module, ADR-0003) ---
# 30-day rotating refresh token, delivered as an httpOnly, Secure,
# SameSite=Strict cookie (Spec §2.2.4/§8.2) — never in a JSON body.
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=talentswap_refresh_token

# --- Auth: password hashing (owned by the `auth` module) ---
# bcrypt cost factor, per Technology Specification §2.6. Bounded 10-15.
BCRYPT_SALT_ROUNDS=12

# --- Auth: local-dev admin bootstrap seed (optional) ---
# Read only by `prisma/seed.ts`'s `// === auth module ===` section, never
# by the application itself. If either is unset, seeding an admin account
# is skipped (logged, not an error) — there is no hardcoded default
# admin password anywhere in this codebase.
SEED_ADMIN_EMAIL=admin@talentswap.local
SEED_ADMIN_PASSWORD=change-me-before-seeding
